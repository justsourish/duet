{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duet",
  "version": "0.3.1",
  "identifier": "com.justsourish.duet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Duet",
        "width": 1440,
        "height": 900,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "GraphicsAndDesign",
    "fileAssociations": [
      {
        "ext": ["duet"],
        "name": "Duet project",
        "description": "A Duet design, with its history inside",
        "role": "Editor",
        "mimeType": "application/x-duet-project"
      }
    ],
    "shortDescription": "Design with an AI, side by side",
    "longDescription": "An opinionated design tool, built by designers, for designers. You and your AI work hand in hand on one canvas.",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
